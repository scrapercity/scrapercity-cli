{
  "name": "scrapercity",
  "version": "1.0.24",
  "description": "ScraperCity SDK, CLI & MCP Server - B2B lead generation for AI agents and developers",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./lib/*": "./lib/*",
    "./bin/*": "./bin/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "scrapercity": "./bin/cli.mjs",
    "scrapercity-mcp": "./bin/mcp.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "SKILL.md",
    "AGENT_DOCS.txt",
    "README.md"
  ],
  "keywords": [
    "scrapercity",
    "mcp",
    "mcp-server",
    "lead-generation",
    "b2b",
    "scraping",
    "apollo",
    "google-maps",
    "email-finder",
    "ai-agent",
    "claude-code",
    "cursor",
    "sdk",
    "api-client",
    "javascript",
    "langchain",
    "openai",
    "function-calling",
    "tool-calling"
  ],
  "author": "ScraperCity",
  "license": "MIT",
  "homepage": "https://scrapercity.com/agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/scrapercity/scrapercity-cli"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "prepublishOnly": "node scripts/generate.mjs --check && bash scripts/publish-python.sh",
    "test": "node --test test/*.test.mjs"
  }
}
